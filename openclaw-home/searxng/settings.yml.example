use_default_settings:
  engines:
    keep_only:
      - bing
      - duckduckgo
      - wikipedia

general:
  debug: false
  instance_name: "openclaw-searxng"

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "zh-CN"
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  public_instance: false
  secret_key: "change-this-secret-before-production"

ui:
  static_use_hash: true

outgoing:
  request_timeout: 20.0
  max_request_timeout: 30.0
  extra_proxy_timeout: 10
  enable_http2: false
  # 如果 SearXNG 需要显式代理，在服务器私有的 settings.yml 里取消注释并填写真实地址。
  # 不要把带密码的 settings.yml 提交到 Git。
  # proxies:
  #   all://:
  #     - http://用户名:密码@代理IP:端口

engines:
  - name: bing
    disabled: false
    timeout: 20.0
    enable_http2: false

  - name: duckduckgo
    disabled: false
    timeout: 20.0
    enable_http2: false

  - name: wikipedia
    disabled: false
    timeout: 20.0
    enable_http2: false
