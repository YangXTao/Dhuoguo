# Timezone
TZ=Asia/Shanghai

# OpenClaw image. Pin this later after you verify the version in production.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Default model for complex reasoning and coding tasks.
OPENCLAW_DEFAULT_MODEL=openai-codex/gpt-5.5

# SearXNG runs in the same Docker Compose network.
SEARXNG_BASE_URL=http://searxng:8080

# Optional proxy if your intranet server needs one to reach Feishu/OpenAI/Codex.
# If the proxy runs on the Docker host, use host.docker.internal.
# Common Clash/Mihomo mixed-port example:
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5h://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,searxng,openclaw-gateway,host.docker.internal
# http_proxy=http://host.docker.internal:7890
# https_proxy=http://host.docker.internal:7890
# all_proxy=socks5h://host.docker.internal:7890
# no_proxy=localhost,127.0.0.1,searxng,openclaw-gateway,host.docker.internal
